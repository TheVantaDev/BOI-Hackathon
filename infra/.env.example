# Database
DATABASE_URL=postgresql://cognidroid:sentinel_pass@localhost:5432/sentinel_db

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sentinel_minio
MINIO_SECRET_KEY=sentinel_minio_pass
MINIO_BUCKET=apk-uploads

# Microservice URLs (local dev)
STATIC_ANALYSIS_URL=http://localhost:8010
DYNAMIC_ANALYSIS_URL=http://localhost:8011
THREAT_INTEL_URL=http://localhost:8012
RAG_ENGINE_URL=http://localhost:8013
AI_ENGINE_URL=http://localhost:8014
FRAUD_ENGINE_URL=http://localhost:8015
RISK_SCORING_URL=http://localhost:8016

# AI / Ollama
# Local (services on host): http://localhost:11434
# Docker Compose overrides this to http://ollama:11434 for ai/fraud/rag containers
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Seconds; Compose sets 300 for ai-investigation-engine (CPU llama can be slow)
OLLAMA_TIMEOUT=300

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# External Threat Intel APIs (optional)
ABUSEIPDB_API_KEY=
MALWAREBAZAAR_API_KEY=
URLHAUS_API_KEY=
# Note: URLHaus and OpenPhish work without API keys (free public feeds)
# Note: MalwareBazaar hash lookup also works without a key

# MobSF Dynamic Analysis
MOBSF_URL=http://localhost:8008
# Get the API key from MobSF UI: http://localhost:8008 -> REST API -> API Key
MOBSF_API_KEY=sentinel_mobsf_key
MOBSF_TIMEOUT=300

# Android Emulator (for MobSF Dynamic Analysis)
# Run your AVD from Android Studio, then: adb tcpip 5555
# On Windows with Docker Desktop: host.docker.internal resolves to your host machine
ANDROID_EMULATOR_HOST=host.docker.internal
ANDROID_EMULATOR_PORT=5555

# Frida Scripts (auto-mounted into dynamic-analysis container)
FRIDA_SCRIPTS_DIR=/app/frida_scripts
